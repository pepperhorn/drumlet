{
  "kitVersion": "v6",
  "DOCS": "docs",
  "DECISIONS": "docs/decisions",
  "LEDGER": "docs/wip/LEDGER.md",
  "DECISIONS_REL": "decisions",
  "LEDGER_REL": "wip/LEDGER.md",
  "MAIN_BRANCH": "main",
  "VERIFY_CMD": "npm run typecheck && npm run lint && npm run build",
  "WORKTREE_SETUP": "npm ci; no secrets required for local checks (Directus auth hits apps.pepperhorn.com at runtime). For any .env needs, use the shared-env skill and confirm dev or prod with the user; never copy secrets into source.",
  "PORT_BASE": 5200,
  "REMOTE": "origin",
  "MERGE": "squash",
  "GBRAIN_PROJECT": "drumlet",
  "AUTO_MERGE": "small",
  "AUTO_MERGE_MAX_LINES": 50,
  "SWEEP_PRS": true,
  "SCAN_DAYS": 7,
  "STOP_MAX_BLOCKS": 3,
  "IMPL_PROVIDER": "codex",
  "IMPL_MODEL": "latest:sol",
  "IMPL_OPTIONS": {"reasoningEffort": "high"},
  "ALT_PROVIDER": "claudeAgent",
  "ALT_MODEL": "latest:sonnet",
  "ALT_OPTIONS": {"effort": "high"},
  "REVIEW_PROVIDER": "claudeAgent",
  "REVIEW_MODEL": "latest:opus",
  "REVIEW_OPTIONS": {"effort": "high"},
  "ALT_REVIEW_PROVIDER": "codex",
  "ALT_REVIEW_MODEL": "latest:sol",
  "ALT_REVIEW_OPTIONS": {"reasoningEffort": "high"}
}
